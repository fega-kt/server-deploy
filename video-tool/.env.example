# File này là tài liệu tham chiếu cho secrets cần lưu trong Vault.
# KHÔNG dùng file này trực tiếp ở production.
#
# Cách deploy:
#   1. Copy .vault.json.example → .vault.json rồi điền địa chỉ Vault + path
#   2. Lưu các key dưới đây vào Vault tại path "secret/video-tool" trong .vault.json
#   3. Chạy: bash up.sh   (script tự fetch từ Vault, ghi .env, rồi docker compose up -d)

# Image GHCR (build từ repo tools_video, workflow tự push tag :latest + :sha-<commit>)
APP_IMAGE=ghcr.io/fega-kt/tools_video:latest

# Port host bind (127.0.0.1 only, ra ngoài qua Cloudflare Tunnel — xem cloudflared/config.example.yml)
VIDEO_TOOL_PORT=8501

# Token gói Claude Pro/Max — tool dùng Claude Code để viết kịch bản, kiểm chứng, chọn thumbnail.
# Lấy bằng: claude setup-token   (chạy trên máy đã đăng nhập Claude). Chỉ dùng cho riêng bạn.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# MongoDB (Atlas) — lưu user và phiên đăng nhập. Nhớ thêm IP server vào Atlas → Network Access.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGODB_DB=video_tool

# Khóa bí mật khi băm mật khẩu + token đăng nhập (ít nhất 32 ký tự). Sinh bằng: openssl rand -base64 48
# Phải GIỐNG máy cá nhân nếu dùng chung database MongoDB. Đổi/mất khóa → mọi mật khẩu & phiên mất hiệu lực.
AUTH_SECRET=change-me

# Số ngày giữ đăng nhập khi chọn "Ghi nhớ đăng nhập"
SESSION_DAYS=30

# Video nền (Pixabay, miễn phí: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your-pixabay-key

# Ngôn ngữ mặc định: vi | en
VIDEO_LANG=vi

# (Tuỳ chọn) Thư mục video trên host, mặc định ./data/output
# OUTPUT_PATH=/mnt/videos
