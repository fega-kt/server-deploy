# File này là tài liệu tham chiếu cho secrets cần lưu trong Vault.
# KHÔNG dùng file này trực tiếp ở production.
#
# Cách deploy:
#   1. Copy .vault.json.example → .vault.json rồi điền địa chỉ Vault + path
#   2. Lưu các key dưới đây vào Vault tại path "secret/flowable" trong .vault.json
#   3. Chạy: bash up.sh   (script tự fetch từ Vault, ghi .env, rồi docker compose up -d)

# Image GHCR (build từ repo flowable riêng, workflow tự push tag :latest + :sha-<commit>)
APP_IMAGE=ghcr.io/fega-kt/flowable-rest-flowable-server:latest

# Port host bind (127.0.0.1 only, ra ngoài qua Cloudflare Tunnel — xem cloudflared/config.example.yml)
# 8080 đã dùng bởi zhizhu-web, 8081 đã dùng bởi Portainer (docker/) — dùng 8082 cho flowable.
FLOWABLE_PORT=8082

# Supabase Database
# Lấy từ: Supabase Dashboard → Settings → Database → Connection string.
# Docker compose tự ghép lại thành jdbc:postgresql://HOST:PORT/NAME?sslmode=require (xem docker-compose.yml).
#
# QUAN TRỌNG — chọn đúng loại connection:
#   - Direct connection (khuyên dùng cho Flowable): host "db.[PROJECT_REF].supabase.co", port 5432,
#     user "postgres". Flowable chạy DDL (FLOWABLE_DATABASE_SCHEMA_UPDATE=true) và dùng JDBC
#     server-side prepared statement — không tương thích tốt với pooler chế độ Transaction.
#   - Nếu bắt buộc phải qua pooler (Supavisor): dùng port 5432 (Session mode), KHÔNG dùng port 6543
#     (Transaction mode) — Transaction mode sẽ làm hỏng prepared statements/DDL của Hibernate.
#     Với pooler, user phải có dạng "postgres.[PROJECT_REF]" (khác với direct connection).
SUPABASE_DB_HOST=db.[PROJECT_REF].supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Flowable Admin (dùng để gọi REST API)
FLOWABLE_ADMIN_USER=admin
FLOWABLE_ADMIN_PASSWORD=your-secure-password
FLOWABLE_ADMIN_EMAIL=admin@example.com

# Shared secret Flowable ↔ NestJS (header X-Internal-Auth)
# Sinh bằng: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=your-random-secret-here

# URL NestJS internal API — PLACEHOLDER, chưa có service NestJS trong zhizhu-server-deploy.
# Điền khi approval-app NestJS được deploy (container name nếu join zhizhu_net, hoặc URL external).
NESTJS_INTERNAL_BASE_URL=http://nestjs:3000
