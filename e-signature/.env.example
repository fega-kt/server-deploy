# Lưu các key này trong Vault tại secret/zhizhu/e-signature — up.sh ghi ra .env

# base64 của 32 byte ngẫu nhiên: openssl rand -base64 32
# MẤT LÀ MẤT TOÀN BỘ KHÓA KÝ — lưu thêm một bản ở nơi an toàn ngoài Vault
Signing__MasterKey=
# Token dùng chung với backend (ESIGN_SERVICE_TOKEN), ≥ 32 ký tự
Signing__ServiceToken=
Signing__Organization=Zhizhu
Signing__CaName=Zhizhu Internal CA

# Kho khóa ký: bucket R2 RIÊNG, token chỉ có quyền trên bucket này
Signing__KeyStore__Driver=r2
Signing__KeyStore__R2AccountId=
Signing__KeyStore__R2AccessKeyId=
Signing__KeyStore__R2SecretAccessKey=
Signing__KeyStore__R2Bucket=

# (Tuỳ chọn) port host bind, mặc định 8094
# E_SIGNATURE_PORT=8094
